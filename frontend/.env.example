# REQUIRED — point the frontend at the backend API (JWT auth).
# Example (local dev): http://localhost:8000/api
#
# Copy this file to `.env.local` and set the value for your backend.
#
# There is NO demo/offline mode. The in-memory mock service layer was deleted, so
# the frontend cannot run without a backend — it refuses to start if this is unset
# rather than serving fake data.
#
# NOTE: NEXT_PUBLIC_* is inlined into the bundle at BUILD time, so it must be set
# when you run `next build`, not only at runtime.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Company SSO (OIDC) — the "Continue with company SSO" login button.
# In DEVELOPMENT these are already set in `.env.development`, so the button works
# out of the box against the bundled demo IdP (backend config.settings.dev). When
# BOTH are set the button sends the browser to the SP-initiated login URL; when
# unset it stays visible but disabled with a "coming soon" caption.
# For a PRODUCTION build, point them at your real backend host (or leave unset):
#   NEXT_PUBLIC_SSO_ENABLED=true
#   NEXT_PUBLIC_SSO_LOGIN_URL=https://<backend-host>/api/auth/sso/login/

# On-net / Off-net access mode (spec 2.6.2). When true, the app shows a dev-only
# toggle to simulate the network origin (demo, matches backend NET_MODE_DEMO). Leave
# unset/false for production builds — the mode then comes from the real client IP.
#   NEXT_PUBLIC_NET_DEMO=true
