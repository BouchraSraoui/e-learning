# Development env — loaded by `next dev` only, NOT by production builds.
# Enables the demo SSO login button so "Continue with company SSO" works end to end
# against the bundled demo IdP (the backend's config.settings.dev mounts it at
# /oidc-demo). Production builds use .env.production / real env, where SSO stays off
# until the real Icosnet directory is configured.
#
# Uses 127.0.0.1 (not localhost) so the whole OIDC handshake — login, IdP, callback —
# stays on the one host the backend actually listens on. See config/settings/dev.py:
# on Windows "localhost" resolves to IPv6 ::1 first and the dev server's self-requests
# to the demo IdP stall/fail there, which the client saw as sso_failed.
NEXT_PUBLIC_SSO_ENABLED=true
NEXT_PUBLIC_SSO_LOGIN_URL=http://127.0.0.1:8000/api/auth/sso/login/

# On-net/Off-net demo (spec 2.6.2): show the dev-only origin toggle in the user menu
# so the access mode can be flipped without the real Icosnet LAN/VPN. The backend
# (config.settings.dev) trusts the simulated header only under DEBUG. Off in prod.
NEXT_PUBLIC_NET_DEMO=true
