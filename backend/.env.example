# Copy to .env for local dev.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — the standard setup (see README: `docker run ... --name icosnet-pg`).
# Uncomment once the container exists. 127.0.0.1 on purpose (NOT "localhost"): on
# Windows, localhost resolves to IPv6 ::1 first and every connection stalls ~2s.
# Leave commented to fall back to the bundled SQLite file (backend/db.sqlite3).
# DATABASE_URL=postgres://icosnet:icosnet@127.0.0.1:5432/icosnet
# REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# On-net / Off-net access mode (spec 2.6.2). Defaults live in config/settings/base.py.
# Prod derives the mode from the real client IP; the dev demo simulates it via the
# front-end toggle (dev.py already sets NET_MODE_DEMO=true).
# NET_ONNET_CIDRS=10.0.0.0/8,192.168.0.0/16   # internal Icosnet ranges = on-net (prod)
# NET_TRUST_FORWARDED_FOR=false                # true ONLY behind a trusted reverse proxy
# NET_MODE_DEMO=false                          # dev-only header simulation; NOT a security boundary

# Email (dev uses console backend by default)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@gmail.com

# Assistant / RAG (served by Ollama — `ollama pull bge-m3 && ollama pull qwen2.5:7b`).
# Defaults live in config/settings/base.py; override here to tune without code changes.
# ASSISTANT_OLLAMA_URL=http://localhost:11434
# ASSISTANT_OLLAMA_FALLBACK_URL=       # optional 2nd Ollama, used automatically if the primary is unreachable (e.g. a dev GPU tunnel that rotated); empty = off
# ASSISTANT_EMBED_MODEL=bge-m3
# ASSISTANT_LLM_MODEL=qwen2.5:7b      # qwen2.5:3b = faster/weaker; qwen3 only on a GPU (reasoning-first)
# ASSISTANT_LLM_THINK=False           # only relevant for reasoning models (qwen3) on a GPU box
# ASSISTANT_SIMILARITY_THRESHOLD=0.55
# ASSISTANT_RAG_TOP_K=5
# ASSISTANT_RAG_MAX_CONTEXT=2         # THE latency knob: each extra chunk costs ~23s on a CPU box
# Latency knobs (see `manage.py warm_assistant`):
# ASSISTANT_OLLAMA_KEEP_ALIVE=60m     # keep both models resident; '0' unloads immediately
# ASSISTANT_LLM_NUM_PREDICT=192       # decode cap — the answer is meant to be 1-4 sentences
# ASSISTANT_LLM_NUM_CTX=3072          # must stay above the real prompt size; raise with MAX_CONTEXT
# Cloud LLM (only if data residency / Loi 18-07 allows — see docs/PHASE-7-RAG.md):
# ASSISTANT_LLM_CLIENT=apps.assistant.clients.OllamaLLMClient
